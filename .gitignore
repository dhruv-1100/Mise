# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Spike / scratch output ------------------------------------------------
# Guardrail: raw transcripts, captions, and video descriptions may only ever be
# written here, and this directory never enters version control.
scripts/spike_output/

# --- Node ------------------------------------------------------------------
node_modules/
.pnpm-store/
*.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Build output
dist/
build/
coverage/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
# CI installs the container's runtime-only dependency set here to prove the
# production entrypoint imports without dev packages. See ci.yml.
.venv-runtime/

# Playwright
/apps/web/playwright-report/
/apps/web/test-results/
/apps/web/blob-report/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Terraform -------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# versions and hashes the same way pnpm-lock.yaml does, and Terraform expects
# it in version control.

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
