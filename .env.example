# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# YouTube Data API v3
# ---------------------------------------------------------------------------
# console.cloud.google.com
#   -> new project
#   -> APIs & Services -> Library -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
#
# Quota: 10,000 units/day by default. Costs are NOT uniform —
#   videos.list          1 unit
#   captions.list       50 units
#   captions.download  200 units
# so a captions-heavy workload burns the daily budget fast. Budget deliberately.
YOUTUBE_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio) — the LLM extraction stage
# ---------------------------------------------------------------------------
# aistudio.google.com -> Get API key. See docs/adr/0002-llm-provider.md for why
# Gemini rather than the Anthropic API the build plan assumed.
#
# Model availability moves: gemini-2.5-flash now 404s for new keys and
# gemini-3.6-flash returned 503 under load on the same day. The extractor walks
# an ordered fallback list rather than pinning one name.
GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Phase 1+ — not yet used. Listed so the shape of the config is visible early.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/db
# Upstash Redis, from `terraform -chdir=infra output -raw redis_url`.
# Without it the async job endpoints return 503 not_configured; POST /extract
# still works synchronously.
REDIS_URL=rediss://default:pass@host:6379
# apps/web -> extractor. Local dev runs the extractor's gRPC server on 50051;
# in production this is the Cloud Run URL.
EXTRACTOR_GRPC_ADDRESS=127.0.0.1:50051
# Canonical URLs and Open Graph tags are built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 6.2 — accounts
# ---------------------------------------------------------------------------
# Neon Postgres. Use the POOLED string from serverless functions, which open far
# more connections than a long-lived process would:
#
#   terraform -chdir=infra output -raw database_url_pooled
#
# Absent, the app runs signed-out: recipes work, accounts do not.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Session encryption. Any 32+ bytes of randomness:
#
#   openssl rand -base64 32
#
# Rotating this signs everyone out — that is the emergency lever, not a bug.
AUTH_SECRET=

# Google OAuth2 client, from console.cloud.google.com -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Web application.
#
# Authorised redirect URI, exactly:
#   http://localhost:3000/api/auth/callback/google        (dev)
#   https://YOUR-DOMAIN/api/auth/callback/google          (prod)
#
# The consent screen needs the youtube.readonly scope added for creator channel
# claiming. That scope is SENSITIVE: Google caps unverified apps at 100 users
# and requires review beyond that. Only claimers ever touch it — ordinary
# sign-in uses openid/email/profile, which needs no review. See
# docs/adr/0003-auth-and-sessions.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed if the deployment URL cannot be inferred (most cannot on Vercel,
# where it is automatic). Set AUTH_TRUST_HOST=true behind a proxy.
# AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 6.3 — analytics
# ---------------------------------------------------------------------------
# PostHog project API key, from posthog.com -> Project settings. Write-only and
# safe in the browser, which is why it is NEXT_PUBLIC_ — the server-side sink
# reads the same variable rather than needing a second key.
#
# Unset, every sink is the no-op: the app is fully functional with no analytics,
# and a missing key can never be why a page throws.
#
# Cohort definitions live in docs/adr/0004-analytics-and-retention.md. Read them
# before quoting a retention number.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud by default. EU is https://eu.i.posthog.com; self-hosted is your URL.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
