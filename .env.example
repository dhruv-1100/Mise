# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# YouTube Data API v3
# ---------------------------------------------------------------------------
# console.cloud.google.com
#   -> new project
#   -> APIs & Services -> Library -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
#
# Quota: 10,000 units/day by default. Costs are NOT uniform —
#   videos.list          1 unit
#   captions.list       50 units
#   captions.download  200 units
# so a captions-heavy workload burns the daily budget fast. Budget deliberately.
YOUTUBE_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Phase 1+ — not yet used. Listed so the shape of the config is visible early.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/db
# REDIS_URL=rediss://default:pass@host:6379
# ANTHROPIC_API_KEY=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
