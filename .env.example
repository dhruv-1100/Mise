# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# YouTube Data API v3
# ---------------------------------------------------------------------------
# console.cloud.google.com
#   -> new project
#   -> APIs & Services -> Library -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
#
# Quota: 10,000 units/day by default. Costs are NOT uniform —
#   videos.list          1 unit
#   captions.list       50 units
#   captions.download  200 units
# so a captions-heavy workload burns the daily budget fast. Budget deliberately.
YOUTUBE_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio) — the LLM extraction stage
# ---------------------------------------------------------------------------
# aistudio.google.com -> Get API key. See docs/adr/0002-llm-provider.md for why
# Gemini rather than the Anthropic API the build plan assumed.
#
# Model availability moves: gemini-2.5-flash now 404s for new keys and
# gemini-3.6-flash returned 503 under load on the same day. The extractor walks
# an ordered fallback list rather than pinning one name.
GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Phase 1+ — not yet used. Listed so the shape of the config is visible early.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/db
# Upstash Redis, from `terraform -chdir=infra output -raw redis_url`.
# Without it the async job endpoints return 503 not_configured; POST /extract
# still works synchronously.
REDIS_URL=rediss://default:pass@host:6379
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
